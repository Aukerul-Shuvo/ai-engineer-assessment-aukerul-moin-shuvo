# Copy to .env and fill in the secrets. Every variable maps to a field in app/config.py.
# Lines left as KEY= are treated as unset.

# ---- Runtime ---------------------------------------------------------------
# dev | test | prod. prod refuses to start when required secrets are missing; dev warns.
ENVIRONMENT=dev
LOG_LEVEL=INFO
# true | false. Unset means JSON logs in prod and coloured console output elsewhere.
# LOG_JSON=

# ---- Model providers (at least one required) --------------------------------
# Primary. Free key: https://aistudio.google.com
GEMINI_API_KEY=
# Free-tier quotas are metered per model (AI Studio dashboard, 2026-09-09): Flash Lite models
# 15 requests/min and 500/day, larger Flash models 5/min and 20/day. A question costs 4-9 calls,
# so the lite models lead and each model in the chain is its own budget.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
GEMINI_MODEL_RPM=gemini-3.5-flash-lite:15,gemini-3.1-flash-lite:15,gemini-3.5-flash:5
# minimal | low | medium | high. The graph's calls are short structured judgements.
GEMINI_THINKING_LEVEL=minimal
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# Free tier counts each embedded text as a request: 100/min, 1,000/day. The build paces to this.
EMBED_TEXTS_PER_MINUTE=100
LLM_TEMPERATURE=0
# Deadline for one model call. Keep it well inside ASK_TIMEOUT_S divided by the number of
# calls a question makes, so one degraded provider fails over instead of eating the request.
LLM_TIMEOUT_S=15
# SDK-level retries per call; failover to the next model is the main recovery.
LLM_MAX_RETRIES=1

# ---- Superhero API (required) ------------------------------------------------
# Token: https://superheroapi.com, sign in with GitHub.
SUPERHERO_API_TOKEN=
SUPERHERO_BASE_URL=https://superheroapi.com/api
SUPERHERO_TIMEOUT_S=10
SUPERHERO_CACHE_TTL_S=600
SUPERHERO_CACHE_SIZE=512
SUPERHERO_MAX_RETRIES=2
# Circuit breaker: open after this many consecutive failures, probe again after this many seconds.
SUPERHERO_BREAKER_FAILURES=5
SUPERHERO_BREAKER_RECOVERY_S=30

# ---- HTTP API ------------------------------------------------------------------
# When set, POST /ask requires the header X-API-Key with this value.
# API_KEY=
RATE_LIMIT=30/minute
MAX_QUESTION_CHARS=1000
ASK_TIMEOUT_S=90
# JSON list of allowed origins, e.g. ["http://localhost:3000"]
CORS_ORIGINS=[]

# ---- Retrieval -------------------------------------------------------------------
DATA_DIR=data
# Nearest paragraphs taken from the vector index per query, then reranked.
DENSE_TOP_K=100
# Depths were set from the measured recall curve and rerank cost table in evals/RESULTS.md.
RERANK_CANDIDATES=50
RERANK_TOP_K=20
RERANKER_ENABLED=true
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2
# Model weights (34 MB) download here on first run.
RERANKER_CACHE_DIR=data/models
# 256 halves the rerank cost at a measured cost of one point of recall@1.
RERANKER_MAX_LENGTH=512

# ---- Agent graph -------------------------------------------------------------------
MAX_AGENT_STEPS=4
MAX_QUERY_REWRITES=1
MAX_REGENERATIONS=1
MAX_SUB_QUERIES=6
GRADE_TOP_K=10
EVIDENCE_PER_SUB_QUERY=6

# ---- Tools ---------------------------------------------------------------------------
# inprocess (default) | mcp
TOOLS_BACKEND=inprocess
# Streamable HTTP MCP server URL. Unset with TOOLS_BACKEND=mcp spawns the bundled stdio server.
# MCP_SERVER_URL=

# ---- Caching and sessions ------------------------------------------------------------
RESPONSE_CACHE_TTL_S=300
RESPONSE_CACHE_SIZE=1024
SESSION_TTL_S=1800
SESSION_MAX_TURNS=6

# ---- Observability ---------------------------------------------------------------------
# Tracing is off unless an OTLP endpoint is set, e.g. http://localhost:4317 with the compose
# observability profile. grpc (port 4317) or http/protobuf (port 4318, path /v1/traces).
# OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=ai-engineer-assessment
# Prometheus metrics at GET /metrics.
METRICS_ENABLED=true
